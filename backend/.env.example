# DoctorDirect Backend — Environment Configuration
#
# Copy this file to .env and fill in values for your local setup.
# .env is git-ignored and must NEVER be committed.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# Local Homebrew: postgresql://postgres:password@localhost:5432/doctordirect
# Docker:         postgresql://postgres:password@localhost:5432/doctordirect
DATABASE_URL=postgresql://postgres:password@localhost:5432/doctordirect

# Remote PostgreSQL connections use certificate-verified TLS.
# Set DATABASE_SSL_CA if the provider's trusted root CA is not in the system trust store.
# DATABASE_SSL_CA=/absolute/path/to/postgresql-root-ca.pem
# For hosts without a mounted file system (such as Render), set the same PEM file
# as Base64 instead. Generate it locally with: base64 < /path/to/postgresql-root-ca.pem
# DATABASE_SSL_CA_BASE64=LS0tLS1CRUdJTi...

# ── Supabase Auth ──────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── WebRTC signaling (no TURN credential is ever sent by this server) ─────────
SIGNALING_PATH=/api/v1/signaling
# Set true behind an HTTPS reverse proxy. Production signaling rejects non-TLS upgrades.
TRUST_PROXY=false
# Comma-separated. TURN credentials remain on the backend and are disclosed only
# to an authenticated participant of an active consultation.
WEBRTC_STUN_URLS=stun:stun.example.org:3478
WEBRTC_TURN_URLS=turn:turn.example.org:3478?transport=udp,turns:turn.example.org:5349
WEBRTC_TURN_USERNAME=replace-with-turn-username
WEBRTC_TURN_CREDENTIAL=replace-with-turn-credential
