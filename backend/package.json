{
  "name": "doctordirect-backend",
  "version": "0.1.0",
  "description": "DoctorDirect REST API server",
  "main": "dist/server.js",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "ts-node-dev --transpile-only src/db/migrate.ts up",
    "migrate:prod": "node dist/db/migrate.js up",
    "migrate:down": "ts-node-dev --transpile-only src/db/migrate.ts down",
    "migrate:status": "ts-node-dev --transpile-only src/db/migrate.ts status",
    "migrate:reset": "ts-node-dev --transpile-only src/db/migrate.ts reset",
    "seed": "ts-node-dev --transpile-only src/db/migrate.ts seed",
    "test:auth-linking": "ts-node test-auth-account-linking.ts",
    "test:cors": "ts-node test-cors-policy.ts",
    "test:signaling": "ts-node test-signaling-auth.ts",
    "test:turn": "ts-node test-turn-credentials.ts",
    "test:webrtc-config": "ts-node test-webrtc-config.ts",
    "test:ice-servers": "ts-node test-ice-servers.ts",
    "test": "export NODE_ENV=development WEBRTC_TURN_AUTH_MODE=static WEBRTC_STUN_URLS=stun:stun.test.invalid:3478 WEBRTC_TURN_URLS=turn:test.invalid:3478?transport=udp WEBRTC_TURN_USERNAME=test-user WEBRTC_TURN_PASSWORD=test-password WEBRTC_TURN_SHARED_SECRET= CORS_ORIGINS=http://localhost:5173 && npm run test:auth-linking && npm run test:cors && npm run test:signaling && npm run test:turn && npm run test:webrtc-config && npm run test:ice-servers"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@types/ws": "^8.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.23.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.23.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  }
}
