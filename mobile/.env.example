# DoctorDirect Mobile — Environment Configuration
#
# Copy this file to .env and fill in values for your local setup.
# .env is git-ignored and must NEVER be committed.
#
# For physical devices, replace localhost with your LAN IP (e.g. 192.168.1.50)

EXPO_PUBLIC_API_BASE_URL=http://localhost:5001/api/v1
EXPO_PUBLIC_SIGNALING_URL=ws://localhost:5001
